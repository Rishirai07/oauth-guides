# Required for live guide generation. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: comma-separated model IDs to try first (falls back to gemini-flash-latest, gemini-3.5-flash, gemini-2.5-flash)
GEMINI_MODEL=

# Optional: durable storage so generated guides get permanent /guides/<slug> links.
# On Vercel: Storage → Upstash for Redis (Marketplace) adds these automatically (KV_REST_API_URL / KV_REST_API_TOKEN also work).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: generations allowed per IP per 10 minutes (protects your key on a public link). Default 6.
GENERATE_LIMIT_PER_10MIN=6

# Set to 1 to replay a canned agent run without calling Gemini (UI dev / demo fallback).
MOCK_AGENT=
